    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
